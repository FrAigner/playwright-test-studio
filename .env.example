# Anthropic API-Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: welches Claude-Modell der Agent nutzen soll
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Port des Webservers (Default 8124)
# PORT=8124

# Optional: Pfad zum Chromium-Binary (Default /usr/bin/chromium, passt zum
# bereits auf dem Pi vorhandenen Chromium)
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
